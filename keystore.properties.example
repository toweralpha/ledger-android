# Copy this file to `keystore.properties` and fill in your own values.
#
# `keystore.properties` is listed in .gitignore and must NEVER be committed:
# with the keystore file and this password, anyone can sign an APK that Android
# accepts as a legitimate update to an already-installed copy of this app.
#
# Without this file, release builds fall back to the debug signature, which is
# fine for local testing but cannot be published or upgraded in place.

storeFile=release.jks
storePassword=
keyAlias=ledger
keyPassword=
